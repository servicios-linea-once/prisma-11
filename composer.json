{
    "name": "servicio-linea-once/prisma-11",
    "description": "Biblioteca de diseño y componentes UI de alta gama para el ecosistema Laravel (Blade + Livewire + Alpine.js + Tailwind CSS).",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Servicio Línea Once",
            "email": "contacto@serviciolineaonce.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/view": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "laravel/prompts": "^0.1|^0.2|^0.3",
        "livewire/livewire": "^3.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.0|^3.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0",
        "phpstan/phpstan": "^1.12|^2.0",
        "symfony/var-dumper": "^6.0|^7.0|^8.0"
    },
    "autoload": {
        "psr-4": {
            "ServicioLineaOnce\\Prisma11\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ServicioLineaOnce\\Prisma11\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ServicioLineaOnce\\Prisma11\\PrismaServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
